# Polymarket Authentication (Required for Live Execution, optional for Paper Trading)
SIGNER_PRIVATE_KEY=                  # Your Polygon wallet private key (0x...)
POLYMARKET_WALLET_ADDRESS=           # Your Polymarket account address (0x...)
POLYMARKET_RELAYER_API_KEY=          # Optional: Relayer API Key from polymarket.com/settings/api-keys
POLYMARKET_RELAYER_API_KEY_ADDRESS=  # Optional: Signer address shown with your Relayer Key

# Operation Mode (true = paper trading with simulated fills; false = live CLOB orders)
DRY_RUN=true
INITIAL_BANKROLL=500.0

# Telegram Mobile Notifications (Optional but recommended)
TELEGRAM_BOT_TOKEN=                  # From @BotFather on Telegram (e.g. 7123456789:ABCdef...)
TELEGRAM_CHAT_ID=                    # Your Telegram numeric user ID from @userinfobot

# NOTE: Strategy parameters (sizing, risk limits, volume/price/horizon bands,
# league whitelist/blacklist) now live in strategy.yaml, not here.
